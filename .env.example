# Шаблон для .env — скопировать и подставить свои значения:
#   cp .env.example .env
#
# ВНИМАНИЕ: этот файл коммитится в репозиторий. Реальные значения вписывают
# ТОЛЬКО в .env, который закрыт .gitignore. Токен, попавший сюда, становится
# публичным и подлежит немедленному отзыву через @BotFather.
#
# Токен бота выдаёт @BotFather, chat_id можно узнать у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
